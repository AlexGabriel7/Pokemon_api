generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trainer {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  // "TRAINER" | "GYM_LEADER" | "ADMIN" (validado na aplicação)
  role         String         @default("TRAINER")
  createdAt    DateTime       @default(now())
  pokemons     Pokemon[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  // Guardamos só o hash (SHA-256): se o banco vazar, os tokens não podem ser usados
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model Pokemon {
  id             Int      @id @default(autoincrement())
  pokedexId      Int
  name           String
  // SQLite não tem array: os tipos ficam salvos separados por vírgula ("grass,poison")
  types          String
  imageUrl       String?
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int
  specialDefense Int
  speed          Int
  active         Boolean  @default(true)
  capturedAt     DateTime @default(now())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, active])
}
