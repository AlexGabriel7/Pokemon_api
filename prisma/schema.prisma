generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trainer {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  pokemons  Pokemon[]
}

model Pokemon {
  id             Int      @id @default(autoincrement())
  pokedexId      Int
  name           String
  // SQLite não tem array: os tipos ficam salvos separados por vírgula ("grass,poison")
  types          String
  imageUrl       String?
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int
  specialDefense Int
  speed          Int
  active         Boolean  @default(true)
  capturedAt     DateTime @default(now())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, active])
}
