# Banco de dados
DATABASE_URL="file:./dev.db"

# Servidor
PORT=3333
NODE_ENV=development

# JWT (mínimo 32 caracteres). Gere um segredo novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="troque-este-segredo-por-um-valor-aleatorio-com-32-ou-mais-caracteres"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# bcrypt (10 a 15)
BCRYPT_SALT_ROUNDS=12

# CORS: origens permitidas, separadas por vírgula
CORS_ORIGIN="http://localhost:3000"

# Rate limit: janela em ms; limite geral; limite de tentativas falhas em /auth/*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
